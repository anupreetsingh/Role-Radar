<Project Sdk="Microsoft.NET.Sdk">
  <!-- Role Radar for Windows: the tray app, with Setup and Live Tracking (WPF, Windows 11's look).
       The checker is role_radar, in the Python packaged beside it (scripts/package_windows.sh). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- the tray icon (NotifyIcon) -->
    <AssemblyName>RoleRadar</AssemblyName>
    <AssemblyTitle>Role Radar</AssemblyTitle> <!-- its name in Task Manager -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: ThemeMode, Windows 11's look, is marked experimental. WFO0003: Windows Forms (only the tray
         icon here) would set the DPI itself; WPF takes it from the manifest. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF's types, not Windows Forms' (Button, Application...): the tray icon names its own. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoleRadar.Core\RoleRadar.Core.csproj" />
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIconGray.ico" />
  </ItemGroup>
</Project>
