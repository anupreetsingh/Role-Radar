<!-- The app's own looks, on top of Windows 11's (the Fluent theme): the pieces Windows has no control
     for. Colors are the theme's (DynamicResource), so they follow light and dark mode; text sizes are
     the RR.Size.* resources, which follow the text size setting (Ui.cs). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <BooleanToVisibilityConverter x:Key="Visible"/>

  <!-- A job title box on Setup's Roles page: ticked, it's one of the titles searched for. -->
  <Style x:Key="Chip" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="Margin" Value="0,0,6,6"/>
    <Setter Property="FontSize" Value="{DynamicResource RR.Size.12}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Pill" CornerRadius="13" BorderThickness="1" Padding="{TemplateBinding Padding}"
                  Background="{DynamicResource ControlFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{DynamicResource SymbolThemeFontFamily}"
                         FontSize="{DynamicResource RR.Size.9}" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
              <Setter TargetName="Pill" Property="BorderBrush" Value="Transparent"/>
              <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Pill" Property="Opacity" Value="0.85"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- An on/off switch, as Windows 11 draws them. Tag "active": on and working, so green. -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid x:Name="Root" Width="40" Height="20" Background="Transparent">
            <Border x:Name="Track" CornerRadius="10" BorderThickness="1" Background="Transparent"
                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
            <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                     Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/>
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
              <Setter TargetName="Knob" Property="Width" Value="14"/>
              <Setter TargetName="Knob" Property="Height" Value="14"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True"/>
                <Condition Property="Tag" Value="active"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A profession on Setup's first page: it lights up under the pointer, and is outlined once picked
       (Tag "chosen"). -->
  <Style x:Key="ProfessionCard" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Card" CornerRadius="8" BorderThickness="1" Padding="16"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
              <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Card" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="chosen">
              <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
              <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
              <Setter TargetName="Card" Property="Padding" Value="15"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Card" Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A list of jobs that draws only the rows on screen, so a few thousand scroll as fast as a few. -->
  <Style x:Key="JobList" TargetType="ItemsControl">
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ItemsControl">
          <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled">
            <ItemsPresenter/>
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One job (Views/JobList.cs: JobRow): its tick box (or, on its way out, a paper plane), title,
       company and place, when it was found or seen, and Mark as New or "Sending…" at the end. -->
  <DataTemplate x:Key="JobRow">
    <Border x:Name="Row" CornerRadius="6" Padding="0,6" Margin="0,1" Background="Transparent">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding Picked, Mode=TwoWay}" Visibility="{Binding CanPick, Converter={StaticResource Visible}}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0" ToolTip="Select"/>
        <TextBlock Text="&#xE724;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="{DynamicResource RR.Size.12}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Sending, Converter={StaticResource Visible}}"/>
        <StackPanel x:Name="Words" Grid.Column="1" Background="Transparent" Cursor="Hand" Opacity="{Binding Fade}"
                    ToolTip="Open the posting in your browser">
          <TextBlock x:Name="Title" Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"
                     FontSize="{DynamicResource RR.Size.13}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
          <TextBlock Text="{Binding Where}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                     FontSize="{DynamicResource RR.Size.11}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <TextBlock Text="{Binding When}" FontSize="{DynamicResource RR.Size.11}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </StackPanel>
        <Button Grid.Column="2" Content="Mark as New" Tag="mark-new" Margin="8,0" VerticalAlignment="Center"
                FontSize="{DynamicResource RR.Size.11}" ToolTip="Put it back in New jobs"
                Visibility="{Binding Seen, Converter={StaticResource Visible}}"/>
        <TextBlock Grid.Column="2" Text="Sending…" Margin="8,0" VerticalAlignment="Center"
                   FontSize="{DynamicResource RR.Size.11}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding Sending, Converter={StaticResource Visible}}"/>
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
        <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
      </Trigger>
      <Trigger SourceName="Words" Property="IsMouseOver" Value="True">
        <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
      </Trigger>
      <DataTrigger Binding="{Binding Picked}" Value="True">
        <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
