# Alert channels for local runs with `secrets: env` (the default). Copy to .env (never
# commit .env) and load it with:  set -a; source .env; set +a
# On AWS the same names are SecureString parameters under /role-radar/ in SSM
# Parameter Store, e.g. /role-radar/DISCORD_WEBHOOK_URL (see README, "Deploy to AWS").
DISCORD_WEBHOOK_URL=

# Email (optional; any SMTP provider). For Gmail use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls   # starttls | ssl | none
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=               # comma-separated
